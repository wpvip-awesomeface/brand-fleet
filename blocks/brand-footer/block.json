{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "brand-fleet/brand-footer",
	"version": "1.1.0",
	"title": "Brand Footer",
	"category": "brand-fleet",
	"icon": "minus",
	"description": "Four-column brand footer rendered entirely from Brand Identity settings: logo, legal copyright, optional social icons, phones, and address.",
	"keywords": [
		"footer",
		"brand",
		"contact"
	],
	"textdomain": "brand-fleet",
	"editorScript": "brand-fleet-brand-footer-editor",
	"style": "brand-fleet-brand-footer-style",
	"render": "file:./render.php",
	"attributes": {
		"variant": {
			"type": "string",
			"enum": [
				"default",
				"corporate"
			],
			"default": "default"
		},
		"demoNotice": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": [
			"full"
		]
	}
}
